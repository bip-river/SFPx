{
  "name": "sfpx",
  "version": "1.0.0",
  "description": "This repo is a static, front-end-only prototype for buying a forest product permit. It demonstrates a three-step flow where a user selects what they are collecting, chooses a state and office, picks a permit and quantity, and then provides acknowledgements and purchaser details before reviewing a summary.",
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:pdf-vendor": "node scripts/build-pdf-vendor.mjs",
    "test:safari": "node tests/safari.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bip-river/SFPx.git"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.4.299",
    "pdfmake": "^0.3.12",
    "playwright": "^1.64.1",
    "selenium-webdriver": "^4.51.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
